{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProofJournalV1",
  "description": "Proposed contract; validation is not cryptographic verification or authorization.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "action_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checks_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "passed": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "input_digest",
    "artifact_digest",
    "policy_digest",
    "action_digest",
    "checks_digest",
    "passed"
  ]
}
